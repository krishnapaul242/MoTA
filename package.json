{
  "name": "mota-android",
  "displayName": "MoTA Android",
  "description": "Android device controls, screenshots, video capture, recording and replay, APK installs and diagnostics.",
  "version": "0.4.0",
  "publisher": "mota-local",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node --test test/*.test.js",
    "package": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.7.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "mota.pair",
        "title": "MoTA: Pair Device with QR",
        "icon": "$(device-camera)",
        "shortTitle": "Pair with QR"
      },
      {
        "command": "mota.connect",
        "title": "MoTA: Connect by Address",
        "icon": "$(plug)",
        "shortTitle": "Connect"
      },
      {
        "command": "mota.refresh",
        "title": "MoTA: Refresh",
        "icon": "$(refresh)",
        "shortTitle": "Refresh"
      },
      {
        "command": "mota.install",
        "title": "MoTA: Install APK on Devices",
        "icon": "$(desktop-download)",
        "shortTitle": "Install APK"
      },
      {
        "command": "mota.logcat",
        "title": "MoTA: Start Logcat",
        "icon": "$(output)",
        "shortTitle": "Logcat"
      },
      {
        "command": "mota.stopLogs",
        "title": "MoTA: Stop All Logcat Streams"
      },
      {
        "command": "mota.stats",
        "title": "MoTA: Device Info and Live Stats",
        "icon": "$(dashboard)",
        "shortTitle": "Device monitor"
      },
      {
        "command": "mota.forget",
        "title": "MoTA: Forget Connection History"
      },
      {
        "command": "mota.launch",
        "title": "MoTA: Launch App",
        "shortTitle": "Launch app",
        "icon": "$(play)"
      },
      {
        "command": "mota.awake",
        "title": "MoTA: Device Keep Awake",
        "shortTitle": "Keep awake",
        "icon": "$(lightbulb)"
      },
      {
        "command": "mota.recordings",
        "title": "MoTA: Recordings",
        "icon": "$(record)",
        "shortTitle": "Recordings"
      },
      {
        "command": "mota.setupRecorder",
        "title": "MoTA: Set Up Recorder Helper",
        "shortTitle": "Set up recorder helper"
      },
      {
        "command": "mota.device",
        "title": "MoTA: Device Controls",
        "shortTitle": "Device controls",
        "icon": "$(settings-gear)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "mota.devices",
          "name": "Devices"
        },
        {
          "id": "mota.apks",
          "name": "APKs"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "mota.pair",
          "when": "view == mota.devices",
          "group": "navigation"
        },
        {
          "command": "mota.refresh",
          "when": "view == mota.devices || view == mota.apks",
          "group": "navigation"
        },
        {
          "command": "mota.connect",
          "when": "view == mota.devices",
          "group": "navigation"
        },
        {
          "command": "mota.stats",
          "when": "view == mota.devices",
          "group": "navigation@1"
        },
        {
          "command": "mota.launch",
          "when": "view == mota.devices",
          "group": "navigation@2"
        },
        {
          "command": "mota.awake",
          "when": "view == mota.devices",
          "group": "navigation@3"
        },
        {
          "command": "mota.recordings",
          "when": "view == mota.devices",
          "group": "navigation@4"
        },
        {
          "command": "mota.device",
          "when": "view == mota.devices",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "mota.device",
          "when": "view == mota.devices && viewItem == device",
          "group": "inline@0"
        },
        {
          "command": "mota.logcat",
          "when": "view == mota.devices && viewItem == device",
          "group": "inline"
        },
        {
          "command": "mota.stats",
          "when": "view == mota.devices && viewItem == device"
        },
        {
          "command": "mota.install",
          "when": "view == mota.apks",
          "group": "inline"
        },
        {
          "command": "mota.launch",
          "when": "view == mota.devices && viewItem == device",
          "group": "inline@1"
        },
        {
          "command": "mota.awake",
          "when": "view == mota.devices && viewItem == device"
        },
        {
          "command": "mota.recordings",
          "when": "view == mota.devices && viewItem == device"
        },
        {
          "command": "mota.setupRecorder",
          "when": "view == mota.devices && viewItem == device"
        }
      ]
    },
    "configuration": {
      "title": "MoTA Android",
      "properties": {
        "mota.adbPath": {
          "type": "string",
          "default": "adb",
          "description": "ADB executable path. Uses Android SDK environment variables when available."
        },
        "mota.apkGlob": {
          "type": "string",
          "default": "**/*.apk",
          "description": "Workspace APK search pattern; Gradle build folders are included."
        },
        "mota.refreshSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "description": "Device list refresh interval."
        },
        "mota.recordingsDirectory": {
          "type": "string",
          "default": "",
          "description": "Absolute recording directory. Empty uses .mota/recordings in the first workspace folder, or extension storage without a workspace."
        }
      }
    }
  },
  "license": "MIT"
}
