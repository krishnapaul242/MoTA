{
  "name": "mota-android",
  "displayName": "MoTA Android",
  "description": "Android device controls, screenshots, video capture, recording and replay, APK installs and diagnostics.",
  "version": "0.7.4",
  "publisher": "krishna-paul-india-sde",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Testing",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "android",
    "adb",
    "device farm",
    "scrcpy",
    "maestro",
    "react native",
    "screen mirroring",
    "mobile testing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/krishnapaul242/MoTA.git"
  },
  "bugs": {
    "url": "https://github.com/krishnapaul242/MoTA/issues"
  },
  "homepage": "https://github.com/krishnapaul242/MoTA#readme",
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "compile": "tsc -p . && npm run bundle",
    "bundle": "node scripts/bundle.js",
    "vscode:prepublish": "npm run compile",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node --test test/*.test.js",
    "package": "vsce package --allow-missing-repository --no-dependencies -o releases/"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.328",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "qrcode": "^1.5.4",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.7.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "mota.pair",
        "title": "MoTA: Pair Device with QR",
        "icon": "$(device-camera)",
        "shortTitle": "Pair with QR"
      },
      {
        "command": "mota.connect",
        "title": "MoTA: Connect by Address",
        "icon": "$(plug)",
        "shortTitle": "Connect"
      },
      {
        "command": "mota.refresh",
        "title": "MoTA: Refresh",
        "icon": "$(refresh)",
        "shortTitle": "Refresh"
      },
      {
        "command": "mota.install",
        "title": "MoTA: Install APK on Devices",
        "icon": "$(desktop-download)",
        "shortTitle": "Install APK"
      },
      {
        "command": "mota.logcat",
        "title": "MoTA: Start Logcat",
        "icon": "$(output)",
        "shortTitle": "Logcat"
      },
      {
        "command": "mota.stopLogs",
        "title": "MoTA: Stop All Logcat Streams"
      },
      {
        "command": "mota.stats",
        "title": "MoTA: Device Info and Live Stats",
        "icon": "$(dashboard)",
        "shortTitle": "Device monitor"
      },
      {
        "command": "mota.forget",
        "title": "MoTA: Forget Connection History"
      },
      {
        "command": "mota.launch",
        "title": "MoTA: Launch App",
        "shortTitle": "Launch app",
        "icon": "$(play)"
      },
      {
        "command": "mota.awake",
        "title": "MoTA: Device Keep Awake",
        "shortTitle": "Keep awake",
        "icon": "$(lightbulb)"
      },
      {
        "command": "mota.recordings",
        "title": "MoTA: Recordings",
        "icon": "$(record)",
        "shortTitle": "Recordings"
      },
      {
        "command": "mota.setupRecorder",
        "title": "MoTA: Set Up Recorder Helper",
        "shortTitle": "Set up recorder helper"
      },
      {
        "command": "mota.farm",
        "title": "MoTA: Open Device Farm",
        "shortTitle": "Device farm",
        "icon": "$(layout)"
      },
      {
        "command": "mota.device",
        "title": "MoTA: Device Controls",
        "shortTitle": "Device controls",
        "icon": "$(settings-gear)"
      },
      {
        "command": "mota.tests",
        "title": "MoTA: Run Maestro Tests",
        "shortTitle": "Run tests",
        "icon": "$(beaker)"
      },
      {
        "command": "mota.mcpSetup",
        "title": "MoTA: Connect AI Agents (MCP)",
        "shortTitle": "Connect AI agents"
      },
      {
        "command": "mota.installHooks",
        "title": "MoTA: Install Claude Code Hooks (Phone Sharing)"
      },
      {
        "command": "mota.ai.setApiKey",
        "title": "MoTA: Set Anthropic API Key"
      },
      {
        "command": "mota.ai.clearApiKey",
        "title": "MoTA: Remove Anthropic API Key"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "mota.devices",
          "name": "Devices"
        },
        {
          "id": "mota.apks",
          "name": "APKs"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "mota.farm",
          "when": "view == mota.devices",
          "group": "navigation@0"
        },
        {
          "command": "mota.pair",
          "when": "view == mota.devices",
          "group": "navigation"
        },
        {
          "command": "mota.refresh",
          "when": "view == mota.devices || view == mota.apks",
          "group": "navigation"
        },
        {
          "command": "mota.connect",
          "when": "view == mota.devices",
          "group": "navigation"
        },
        {
          "command": "mota.stats",
          "when": "view == mota.devices",
          "group": "navigation@1"
        },
        {
          "command": "mota.launch",
          "when": "view == mota.devices",
          "group": "navigation@2"
        },
        {
          "command": "mota.awake",
          "when": "view == mota.devices",
          "group": "navigation@3"
        },
        {
          "command": "mota.recordings",
          "when": "view == mota.devices",
          "group": "navigation@4"
        },
        {
          "command": "mota.device",
          "when": "view == mota.devices",
          "group": "navigation@0"
        },
        {
          "command": "mota.tests",
          "when": "view == mota.devices",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "mota.device",
          "when": "view == mota.devices && viewItem == device",
          "group": "inline@0"
        },
        {
          "command": "mota.logcat",
          "when": "view == mota.devices && viewItem == device",
          "group": "inline"
        },
        {
          "command": "mota.stats",
          "when": "view == mota.devices && viewItem == device"
        },
        {
          "command": "mota.install",
          "when": "view == mota.apks",
          "group": "inline"
        },
        {
          "command": "mota.launch",
          "when": "view == mota.devices && viewItem == device",
          "group": "inline@1"
        },
        {
          "command": "mota.awake",
          "when": "view == mota.devices && viewItem == device"
        },
        {
          "command": "mota.recordings",
          "when": "view == mota.devices && viewItem == device"
        },
        {
          "command": "mota.setupRecorder",
          "when": "view == mota.devices && viewItem == device"
        }
      ]
    },
    "configuration": {
      "title": "MoTA Android",
      "properties": {
        "mota.adbPath": {
          "type": "string",
          "default": "adb",
          "description": "ADB executable path. Uses Android SDK environment variables when available."
        },
        "mota.apkGlob": {
          "type": "string",
          "default": "**/*.apk",
          "description": "Workspace APK search pattern; Gradle build folders are included."
        },
        "mota.refreshSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "description": "Device list refresh interval."
        },
        "mota.recordingsDirectory": {
          "type": "string",
          "default": "",
          "description": "Absolute recording directory. Empty uses .mota/recordings in the first workspace folder, or extension storage without a workspace."
        },
        "mota.liveEngine": {
          "type": "string",
          "enum": [
            "scrcpy",
            "screenrecord"
          ],
          "enumDescriptions": [
            "scrcpy server: smoother video with live touch, drag, scroll and fast typing. Falls back to screenrecord if it can't start.",
            "Android's screenrecord: video only; taps and swipes go through adb input."
          ],
          "default": "scrcpy",
          "description": "How the live view streams a device's screen."
        },
        "mota.maestroPath": {
          "type": "string",
          "default": "",
          "description": "Maestro CLI path. Empty uses ~/.maestro/bin/maestro when present, otherwise maestro on PATH."
        },
        "mota.maestroFlowsFolder": {
          "type": "string",
          "default": ".maestro",
          "description": "Folder with your Maestro flows, relative to the first workspace folder or absolute."
        },
        "mota.mcp.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Serve MoTA's device, input, app and Maestro tools to AI agents (Claude Code, Cursor, Codex…) over MCP on 127.0.0.1. Run \"MoTA: Connect AI Agents (MCP)\" to set up an agent."
        },
        "mota.mcp.port": {
          "type": "number",
          "default": 6682,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Local port for MoTA's MCP server (http://127.0.0.1:<port>/mcp)."
        },
        "mota.ai.claudePath": {
          "type": "string",
          "default": "",
          "description": "Claude Code CLI that MoTA's assistant runs on, using its existing login. Empty finds claude in ~/.local/bin, ~/.claude/local or on PATH."
        },
        "mota.ai.model": {
          "type": "string",
          "default": "",
          "description": "Model for MoTA's assistant. Empty uses Claude Code's default model."
        },
        "mota.ai.effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "default": "medium",
          "description": "How hard Claude thinks. Higher is slower and uses more tokens."
        },
        "mota.ai.screenshotWidth": {
          "type": "number",
          "default": 960,
          "minimum": 480,
          "maximum": 1600,
          "description": "Longest side, in pixels, of screenshots sent to Claude. Smaller uses fewer tokens."
        },
        "mota.lease.idleSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 10,
          "maximum": 86400,
          "description": "Seconds without activity after which a phone an agent or MoTA's assistant holds counts as idle, and another session may take it at once. A phone running a Maestro test is never idle. A session's own setting comes first, then mota.lease.deviceIdleSeconds."
        },
        "mota.lease.deviceIdleSeconds": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "number",
            "minimum": 10,
            "maximum": 86400
          },
          "markdownDescription": "Idle time per phone, by serial, overriding `mota.lease.idleSeconds`. For example `{ \"emulator-5554\": 300 }`."
        },
        "mota.lease.maxSessionIdleSeconds": {
          "type": "number",
          "default": 900,
          "minimum": 10,
          "maximum": 86400,
          "description": "The longest idle time an agent may set for its own session with acquire_device. Your own settings are not capped."
        }
      }
    }
  },
  "license": "MIT"
}
